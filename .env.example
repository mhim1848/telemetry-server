# Copy to .env and fill in your own values: `cp .env.example .env`
# .env is gitignored;

# --- Server ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
PGHOST=db.example.internal
PGPORT=5432
PGUSER=telemetry_app
# Required (no default): the app refuses to start without a DB password.
PGPASSWORD=replace-with-db-password
PGDATABASE=telemetry
# Set to "true" when connecting to a managed/cloud Postgres over SSL.
PGSSL=false

# --- CORS ---
# Comma-separated list of allowed origins, or "*" to allow all (development only).
# "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173

# --- Ingest auth ---
# Shared secret required on write routes. Optional in development; required in production.
INGEST_API_KEY=replace-with-a-strong-random-secret

# --- Logging ---
# Optional override. One of: fatal, error, warn, info, debug, trace, silent.
# Defaults per environment (prod=info, dev=debug, test=silent) when unset.
# LOG_LEVEL=info
